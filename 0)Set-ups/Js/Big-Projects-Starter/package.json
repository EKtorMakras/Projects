    "format:scss:check": "prettier src/scss --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsonc": "^3.4.2",
    "globals": "^17.13.0",
    "prettier": "3.9.10",
    "sass": "^1.105.1",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@emakras/vanilla-kit": "github:EKtorMakras/vanilla-kit#v0.7.0",
    "@fontsource/baloo-tamma-2": "5.3.0"
  }
}

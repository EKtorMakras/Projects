{
    "name": "nuxt-tailwind-template",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.33.0",
    "engines": {
        "node": ">=22",
        "pnpm": ">=10"
    },
    "scripts": {
        "ds:build": "node scripts/build-theme-css.js",
        "ds:watch": "node scripts/watch-tokens.js",
        "build": "pnpm ds:build && nuxt build",
        "dev": "pnpm ds:build && concurrently \"pnpm ds:watch\" \"nuxt dev\" --kill-others",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "start": "node .output/server/index.mjs"
    },
    "dependencies": {
        "@nuxt/eslint": "^1.17.0",
        "@pinia/nuxt": "^1.0.3",
        "dayjs": "^1.11.23",
        "eslint": "^10.12.0",
        "nuxt": "^4.6.1",
        "pinia": "^4.1.0",
        "vue": "^3.5.44",
        "vue-i18n": "^11.4.14",
        "vue-router": "^5.4.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.6.5",
        "autoprefixer": "^10.6.1",
        "chokidar": "^5.0.0",
        "chroma-js": "^3.2.0",
        "concurrently": "^10.0.6",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.11.1",
        "prettier": "^3.9.10",
        "sass": "^1.105.1",
        "tailwindcss": "^4.3.3"
    }
}
